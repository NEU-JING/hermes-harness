# Hermes SDD Profile 配置模板
# 版本：2.3.0
#
# 使用方式：
#   1. 复制此文件到 ~/.hermes/profiles/<profile_name>/config.yaml
#   2. 替换所有 {{...}} 占位符为实际值
#   3. 或使用 init-profiles.sh 自动生成
#
# 占位符说明：
#   {{profile_name}}     - Profile 名称（如 sdd-po, sdd-ba）
#   {{model}}            - 模型名称（如 deepseek-v4-flash, doubao-seed-2.0-pro）
#   {{provider}}         - Provider 名称（如 DeepSeek, Doubao, GLM）
#

# ─── 模型配置 ───────────────────────────────────────────────
model:
  name: "{{model}}"

# ─── Provider 配置 ──────────────────────────────────────────
provider:
  name: "{{provider}}"

# ─── Profile 元信息 ─────────────────────────────────────────
profile:
  name: "{{profile_name}}"
  description: "SDD {{profile_name}} Profile - Auto-generated by Hermes SDD Harness v2.3.0"

# ─── Workspace 配置 ─────────────────────────────────────────
workspace:
  # SDD 流程强制使用 dir 类型 workspace
  type: "dir"

# ─── 技能配置 ──────────────────────────────────────────────
skills:
  # 由 init-profiles.sh 自动配置，或手动指向 skills/sdd/ 下的技能目录
  enabled: []
